# ==============================================================================
# DULCE ARTE - Variables de Entorno de Ejemplo
# Copiar este archivo a .env y ajustar los valores para su entorno local.
# ==============================================================================

# Configuración de Django
DJANGO_SECRET_KEY=django-insecure-dulce-arte-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SETTINGS_MODULE=config.settings.local

# Configuración de Base de Datos PostgreSQL
DB_NAME=dulce_arte_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS y Seguridad Web
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
